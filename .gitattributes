* text=auto eol=lf
*.vss binary
*.spi text eol=lf
*.inc text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Imported skills retain the pinned upstream bytes, including whitespace.
.agents/skills/** -text !eol whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# These two approved extracts were hashed with CRLF. Preserve their exact
# evidence bytes instead of changing the manifest's pinned identities.
fixtures/visual-reference/razavi-reference-v1/xfmr-vector-source.json -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
fixtures/visual-reference/razavi-reference-v1/tcoil-vector-source.json -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# ngspice failure captures (#1261): the simulator's own bytes, trailing
# spaces and blank lines included.
fixtures/ngspice-failures/*.log -text !eol whitespace=-blank-at-eol,-blank-at-eof
fixtures/ngspice-failures/*.raw -text !eol whitespace=-blank-at-eol,-blank-at-eof
# The vendored SKY130 HD cell netlist (#1596) is pinned by its SHA-256 in the
# hosted Profile: keep the upstream bytes, trailing whitespace included.
containers/ngspice/cells/*.spice -text !eol whitespace=-blank-at-eol,-blank-at-eof
# The Canvas package lock hashes upstream bytes, before text decoding.
apps/editor/src/features/netlist-export/analog-canvas-extensions-*.rnl -text !eol whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# The in-browser simulator's build output (scripts/build-ngspice-wasm.sh) and
# its SKY130 models: the Profile's browser section pins these bytes.
apps/editor/src/features/simulation/browser-ngspice/vendor/ngspice.mjs -text !eol whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
apps/editor/src/features/simulation/browser-ngspice/vendor/ngspice.wasm binary
apps/editor/src/features/simulation/browser-ngspice/vendor/spinit -text !eol whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
apps/editor/src/features/simulation/browser-ngspice/sky130-continuous/*.spice -text !eol whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
