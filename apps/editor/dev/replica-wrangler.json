{
  "name": "analog-canvas-local-replica",
  "main": "../../../worker/index.ts",
  "tsconfig": "../../../tsconfig.check.json",
  "compatibility_date": "2026-08-11",
  "send_metrics": false,
  "vars": { "ADMIN_EMAILS": "owner@replica.invalid" },
  "durable_objects": {
    "bindings": [
      { "name": "TOPOLOGY_TASK", "class_name": "TopologyTaskDO" },
      { "name": "COMPONENT_LIBRARY", "class_name": "ComponentLibraryDO" },
      { "name": "ANALYTICS", "class_name": "AnalyticsDO" },
      { "name": "AGENT_SESSION", "class_name": "AgentSessionDO" },
      { "name": "GALLERY", "class_name": "GalleryDO" },
      { "name": "AUTH", "class_name": "AuthDO" },
      { "name": "SIMULATION_CONTROL", "class_name": "SimulationControlDO" }
    ]
  },
  "r2_buckets": [
    {
      "binding": "SIMULATION_ARTIFACTS",
      "bucket_name": "local-replica-artifacts"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalyticsDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentSessionDO"] },
    { "tag": "v3", "new_sqlite_classes": ["GalleryDO"] },
    { "tag": "v4", "new_sqlite_classes": ["AuthDO"] },
    { "tag": "v5", "new_sqlite_classes": ["SimulationControlDO"] },
    { "tag": "v6", "new_sqlite_classes": ["ComponentLibraryDO"] },
    { "tag": "v7", "new_sqlite_classes": ["TopologyTaskDO"] }
  ]
}
