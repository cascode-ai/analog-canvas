        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "* 01 Underdamped | AC + Step\n* 1. Ready to run. Change the resistance in the alter command below.\n* 2. Click Run.\n* 3. Open Plot for waveforms; expand Measurements when available.\n.temp 27\n.include \"circuit.spice\"\n.control\nset filetype=ascii\nset appendwrite\nalter R1 200\nsave v(in) v(out) i(l1)\n* AC is small-signal response, not an output-swing test.\nac dec 100 100 1Meg\nlet gain_db = db(v(out))\nmeas ac peak_gain_db MAX gain_db\nwrite out.raw\ntran 0.5u 1m 0 0.5u\nmeas tran peak_output MAX v(out)\nmeas tran final_value FIND v(out) AT=1m\nwrite out.raw\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          }
        ],
        "kind": "source"
      },
      "name": "01 Underdamped | AC + Step",
      "version": 4
    },
