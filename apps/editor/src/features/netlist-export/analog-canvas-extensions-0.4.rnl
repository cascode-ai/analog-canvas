    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -0.95)
  };

  /* p n (cp) (cn); from Analog Canvas vcvs (circle): the drawing that the standard series 0.3 had
     before it drew the diamond, which the standard symbol $VCVS draws now */
  $CANVAS_VCVS_CIRCLE = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* p n (cp) (cn); from Analog Canvas vccs (circle) */
  $CANVAS_VCCS_CIRCLE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* p n; from Analog Canvas ccvs (circle) */
  $CANVAS_CCVS_CIRCLE = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* p n; from Analog Canvas cccs (circle) */
  $CANVAS_CCCS_CIRCLE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* p n; from Analog Canvas pulse-voltage-source */
  $CANVAS_PULSE_VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(0.4, -0.7) (0.4, -0.4) (-0.4, -0.4) (-0.4, 0.4) (0.4, 0.4) (0.4, 0.7)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* inp inn outp outn (ck); from Analog Canvas chopper */
  $CANVAS_CHOPPER = @DEFINE-SYMBOL(box=[-2, -3.4, 2, 3.4]) {
    (-2, 1) @PIN(terminal=1, direction="left");
    (-2, -1) @PIN(terminal=2, direction="left");
    (2, 1) @PIN(terminal=3, direction="right");
    (2, -1) @PIN(terminal=4, direction="right");
    @LINE {(-2, 1) (-0.8, 1)};
    @LINE {(-2, -1) (-0.8, -1)};
    @LINE {(0.8, 1) (2, 1)};
    @LINE {(0.8, -1) (2, -1)};
    @LINE(linewidth=0.24) {(-0.8, 3) (0.8, 3) (0.8, -3) (-0.8, -3) (-0.8, 3)};
    @LINE {(-0.8, 3) (0.8, -3)};
    @LINE {(0.8, 3) (-0.8, -3)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.35)
  };

  /* a b c d y (vp) (vn); from Analog Canvas and-gate-4 */
  $CANVAS_AND_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    (-3, 1.2) @PIN(terminal=1, direction="left");
    (-3, 0.4) @PIN(terminal=2, direction="left");
    (-3, -0.4) @PIN(terminal=3, direction="left");
    (-3, -1.2) @PIN(terminal=4, direction="left");
    (2, 0) @PIN(terminal=5, direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    @LINE {(-3, 1.2) (-2, 1.2)};
    @LINE {(-3, 0.4) (-2, 0.4)};
    @LINE {(-3, -0.4) (-2, -0.4)};
    @LINE {(-3, -1.2) (-2, -1.2)};
    @LINE {(1.5, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 1.85)
  };

  /* a b c d y (vp) (vn); from Analog Canvas nand-gate-4 */
  $CANVAS_NAND_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1.2) @PIN(terminal=1, direction="left");
    (-3, 0.4) @PIN(terminal=2, direction="left");
    (-3, -0.4) @PIN(terminal=3, direction="left");
    (-3, -1.2) @PIN(terminal=4, direction="left");
    (3, 0) @PIN(terminal=5, direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    (2.05, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1.2) (-2, 1.2)};
    @LINE {(-3, 0.4) (-2, 0.4)};
    @LINE {(-3, -0.4) (-2, -0.4)};
    @LINE {(-3, -1.2) (-2, -1.2)};
    @LINE {(2.3875, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.85)
  };

  /* a b c d y (vp) (vn); from Analog Canvas or-gate-4 */
  $CANVAS_OR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    (-3, 1.2) @PIN(terminal=1, direction="left");
    (-3, 0.4) @PIN(terminal=2, direction="left");
    (-3, -0.4) @PIN(terminal=3, direction="left");
    (-3, -1.2) @PIN(terminal=4, direction="left");
    (2, 0) @PIN(terminal=5, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    @LINE {(-3, 1.2) (-1.5586, 1.2)};
    @LINE {(-3, 0.4) (-1.2824, 0.4)};
    @LINE {(-3, -0.4) (-1.2824, -0.4)};
    @LINE {(-3, -1.2) (-1.5586, -1.2)};
    @LINE {(1.58, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 2.15)
  };

  /* a b c d y (vp) (vn); from Analog Canvas nor-gate-4 */
  $CANVAS_NOR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1.2) @PIN(terminal=1, direction="left");
    (-3, 0.4) @PIN(terminal=2, direction="left");
    (-3, -0.4) @PIN(terminal=3, direction="left");
    (-3, -1.2) @PIN(terminal=4, direction="left");
    (3, 0) @PIN(terminal=5, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    (2, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1.2) (-1.5586, 1.2)};
    @LINE {(-3, 0.4) (-1.2824, 0.4)};
    @LINE {(-3, -0.4) (-1.2824, -0.4)};
    @LINE {(-3, -1.2) (-1.5586, -1.2)};
    @LINE {(2.3375, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15)
  };

  /* a b c d y (vp) (vn); from Analog Canvas xor-gate-4 */
  $CANVAS_XOR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1.2) @PIN(terminal=1, direction="left");
    (-3, 0.4) @PIN(terminal=2, direction="left");
    (-3, -0.4) @PIN(terminal=3, direction="left");
    (-3, -1.2) @PIN(terminal=4, direction="left");
    (3, 0) @PIN(terminal=5, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @LINE {(-3, 1.2) (-1.5586, 1.2)};
    @LINE {(-3, 0.4) (-1.2824, 0.4)};
    @LINE {(-3, -0.4) (-1.2824, -0.4)};
    @LINE {(-3, -1.2) (-1.5586, -1.2)};
    @LINE {(2.23, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15)
  };

  /* a b c d y (vp) (vn); from Analog Canvas xnor-gate-4 */
  $CANVAS_XNOR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 4, 2.4]) {
    (-3, 1.2) @PIN(terminal=1, direction="left");
    (-3, 0.4) @PIN(terminal=2, direction="left");
    (-3, -0.4) @PIN(terminal=3, direction="left");
    (-3, -1.2) @PIN(terminal=4, direction="left");
    (4, 0) @PIN(terminal=5, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    (2.65, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1.2) (-1.5586, 1.2)};
    @LINE {(-3, 0.4) (-1.2824, 0.4)};
    @LINE {(-3, -0.4) (-1.2824, -0.4)};
    @LINE {(-3, -1.2) (-1.5586, -1.2)};
    @LINE {(2.9875, 0) (4, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.5, 2.15)
  }
}

/* ---------------------------------------------------------------- meaning only (9.4), since 0.2

   Facts of an Analog Canvas drawing that the netlist and the standard series do not keep, so that a
   file Analog Canvas writes comes back to it unchanged. Each is a general definition with an empty
   body and no symbol: a usage of it draws nothing and constrains nothing, so a tool that does not
   know it reads the file as if the usage were not there (it may list the usage as a semantic one).
   Only Analog Canvas writes them; another tool that edits the file leaves them as they are, or
   drops them with the objects they are attached to. */
@RNL {
  /* The name Analog Canvas gives the part, where the netlist must spell it otherwise: a part written
     as a subcircuit call starts with X in SPICE, so the card is XM1 for the part Analog Canvas
     calls M1. Attached to the part: $CANVAS_NAME @ATTACH(name="M1") #XM1 */
  $CANVAS_NAME = @DEFINE(roles=[["part", "instance"]], parameters=["name"]) {};

  /* A label whose text is a fact of the drawing, set as Analog Canvas sets names: it follows when
     the fact changes in Analog Canvas, while the text written in the TEXT is what any viewer shows.
     bind: "name" the part's name, "value" the part's value, "parameter" one parameter of the part
     (its name in parameter), "net" the name of the net, "port" the name of the subcircuit port.
     show_value: false shows the parameter's name only, as Analog Canvas does for such labels.
     Attached to the label: $CANVAS_LABEL @ATTACH(bind="name") #XM1::name */
  $CANVAS_LABEL = @DEFINE(roles=["label"], parameters=["bind", "parameter", "show_value"]) {};

  /* How Analog Canvas sets the names in labels in a level: the case of a subscript ("preserve",
     "uppercase" or "lowercase"), whether a subscript is italic, whether an underscore starts a
     subscript, whether the characters after a leading letter are a subscript, whether the leading
     letter is italic, and the face of all text ("serif"; absent, Analog Canvas's own); and, since
     0.3, how wires that cross without connecting are drawn ("hop": the horizontal wire arcs over the
     vertical one; absent, a plain crossing). A parameter left out is Analog Canvas's default. Attached to the level, a lone # (6.3), in the level's
     own record: $CANVAS_TYPESETTING @ATTACH(subscript_italic=false) #
     Like the rest of a level's RNL it also reaches the levels the level contains (6.1), where a
     usage of their own comes later and gives their settings; Analog Canvas writes one in each
     subcircuit's record, which reaches no other. */
  $CANVAS_TYPESETTING = @DEFINE(roles=["level"], parameters=["subscript_case", "subscript_italic", "underscore_subscript", "subscript_after_first", "first_letter_italic", "face", "crossings"]) {};

  /* The text the author wrote for a parameter, where the netlist writes it otherwise: Spectre takes
     100f for 100fF, and 1M for 1Meg followed by an ohm sign. name is the parameter as the netlist names it, text the
     author's text. Attached to the part, once for each such parameter:
     $CANVAS_PARAMETER_TEXT @ATTACH(name="c", text="100fF") #CCM */
  $CANVAS_PARAMETER_TEXT = @DEFINE(roles=[["part", "instance"]], parameters=["name", "text"]) {};

  /* The typography role in which Analog Canvas sets a drawing text: "caption", "body" or "label".
     There its size follows the document's size for that role, while the size written in the TEXT
     is what any viewer shows. Absent, "body". Attached to the text, which Analog Canvas names in
     its level, since 0.4:
     %t1 = (40, 12) @TEXT("Bias", size=0.9); $CANVAS_TYPOGRAPHY @ATTACH(token="label") %t1 */
  $CANVAS_TYPOGRAPHY = @DEFINE(roles=[["text", "text"]], parameters=["token"]) {};

  /* A parameter Analog Canvas keeps for the part that the netlist does not print: a field of a
     source's waveform other than the one the source is set to, such as the frequency of a source
     set to dc, or the output rails vhigh and vlow of an op amp. name is Analog Canvas's name of the
     parameter, text its text. Attached to the part, once for each such parameter, since 0.4:
     $CANVAS_PARAMETER @ATTACH(name="frequency", text="1k") #I1 */
  $CANVAS_PARAMETER = @DEFINE(roles=[["part", "instance"]], parameters=["name", "text"]) {};

  /* The part has no name in Analog Canvas: the netlist gives it the name a card must have, and
     Analog Canvas leaves it unnamed again. Attached to the part, since 0.4:
     $CANVAS_UNNAMED @ATTACH #X1 */
  $CANVAS_UNNAMED = @DEFINE(roles=[["part", "instance"]]) {};

  /* The Analog Canvas symbol a part is drawn with, where RNL draws two of its symbols alike: an
     op-amp flipped top to bottom is drawn as the op-amp with its inputs swapped, unflipped. symbol
     is Analog Canvas's id of the symbol; without it, Analog Canvas reads such a part as the symbol
     that needs no mirror. Attached to the part, since 0.4:
     $CANVAS_VARIANT @ATTACH(symbol="opamp") #X1 */
  $CANVAS_VARIANT = @DEFINE(roles=[["part", "instance"]], parameters=["symbol"]) {};

  /* The name Analog Canvas gives the Cell a level is, where the netlist must write it otherwise: a
     subcircuit name has no spaces, so the Cell "Bootstrap switch" is the subcircuit
     Bootstrap_switch. Attached to the level, a lone # (6.3), in the level's own record, since 0.4:
     $CANVAS_CELL_NAME @ATTACH(name="Bootstrap switch") #
     Analog Canvas writes one only in the record of the subcircuit it names, which reaches no other
     (6.1). */
  $CANVAS_CELL_NAME = @DEFINE(roles=["level"], parameters=["name"]) {};

  /* The level is the Cell Analog Canvas opens as its project's top, which the netlist need not
     show: a Cell that calls it is printed too, so the netlist's top is that Cell. Attached to the
     level, a lone #, in the level's own record, since 0.4: $CANVAS_TOP @ATTACH # */
  $CANVAS_TOP = @DEFINE(roles=["level"]) {}
}
