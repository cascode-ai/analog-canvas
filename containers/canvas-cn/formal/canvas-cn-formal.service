[Unit]
Description=Analog Canvas isolated regional Project service
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=canvas-formal
Group=canvas-formal
WorkingDirectory=/opt/analog-canvas/current-formal
LoadCredential=regional-client.json:/etc/analog-canvas-formal/regional-client.json
LoadCredential=sync-inbound-token:/etc/analog-canvas-formal/sync-inbound-token
LoadCredential=sync-outbound-token:/etc/analog-canvas-formal/sync-outbound-token
LoadCredential=sync-admin-token:/etc/analog-canvas-formal/sync-admin-token
LoadCredential=peer-origin:/etc/analog-canvas-formal/peer-origin
LoadCredential=identity-url:/etc/analog-canvas-formal/identity-url
LoadCredential=identity-token:/etc/analog-canvas-formal/identity-token
ExecStart=/opt/analog-canvas/runtime/workerd-2026-09-11 serve --import-path=%d /opt/analog-canvas/current-formal/config.capnp
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
InaccessiblePaths=/var/lib/analog-canvas /var/lib/analog-canvas-login
ReadWritePaths=/var/lib/analog-canvas-formal
MemoryHigh=3G
MemoryMax=4G
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
