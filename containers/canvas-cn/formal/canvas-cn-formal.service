[Unit]
Description=Analog Canvas restricted regional trial
After=network-online.target
Wants=canvas-cn-operator.service
After=canvas-cn-operator.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=canvas-formal
Group=canvas-formal
WorkingDirectory=/opt/analog-canvas/current-formal
# BEGIN generated credentials
LoadCredential=identity-token:/etc/analog-canvas-formal/identity-token
LoadCredential=identity-url:/etc/analog-canvas-formal/identity-url
LoadCredential=operator-token:/etc/analog-canvas-formal/operator-token
LoadCredential=peer-origin:/etc/analog-canvas-formal/peer-origin
LoadCredential=project-compress-journal:/etc/analog-canvas-formal/project-compress-journal
LoadCredential=project-protected-ids.json:/etc/analog-canvas-formal/project-protected-ids.json
LoadCredential=project-region-users.json:/etc/analog-canvas-formal/project-region-users.json
LoadCredential=project-sync-expansion:/etc/analog-canvas-formal/project-sync-expansion
LoadCredential=project-writes-enabled:/etc/analog-canvas-formal/project-writes-enabled
LoadCredential=regional-client.json:/etc/analog-canvas-formal/regional-client.json
LoadCredential=resource-admin-token:/etc/analog-canvas-formal/resource-admin-token
LoadCredential=resource-inbound-token:/etc/analog-canvas-formal/resource-inbound-token
LoadCredential=resource-outbound-token:/etc/analog-canvas-formal/resource-outbound-token
LoadCredential=resource-writes-enabled:/etc/analog-canvas-formal/resource-writes-enabled
LoadCredential=simulation-smoke-token:/etc/analog-canvas-formal/simulation-smoke-token
LoadCredential=sync-admin-token:/etc/analog-canvas-formal/sync-admin-token
LoadCredential=sync-inbound-token:/etc/analog-canvas-formal/sync-inbound-token
LoadCredential=sync-outbound-token:/etc/analog-canvas-formal/sync-outbound-token
# END generated credentials
# An earlier narrow candidate used a separate Project namespace; never hide it.
ExecStartPre=/usr/bin/test ! -e /var/lib/analog-canvas-formal/state/canvas-cn-formal-projects-v1
ExecStart=/opt/analog-canvas/runtime/workerd-2026-09-11 serve --experimental --import-path=%d /opt/analog-canvas/current-formal/config.capnp
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
InaccessiblePaths=/var/lib/analog-canvas /var/lib/analog-canvas-login
ReadWritePaths=/var/lib/analog-canvas-formal
MemoryHigh=6G
MemoryMax=8G
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
