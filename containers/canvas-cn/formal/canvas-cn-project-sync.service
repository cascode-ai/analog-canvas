[Unit]
Description=Deliver one durable Canvas Project replication event
After=canvas-cn-formal.service
Requires=canvas-cn-formal.service

[Service]
Type=oneshot
User=canvas-formal
Group=canvas-formal
# Root-owned curl config: header = "Authorization: Bearer <sync-admin-token>".
LoadCredential=sync-curl.conf:/etc/analog-canvas-formal/sync-curl.conf
ExecStart=/usr/bin/curl --config %d/sync-curl.conf --silent --show-error --fail-with-body --max-time 30 --request POST http://127.0.0.1:8792/api/project-sync/run
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
