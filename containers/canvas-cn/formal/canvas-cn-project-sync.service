[Unit]
Description=Deliver one durable Canvas Project replication event
After=canvas-cn-formal.service
Requisite=canvas-cn-formal.service

[Service]
Type=oneshot
User=canvas-formal
Group=canvas-formal
LoadCredential=sync-admin-token:/etc/analog-canvas-formal/sync-admin-token
LoadCredential=sync-inbound-token:/etc/analog-canvas-formal/sync-inbound-token
StateDirectory=canvas-cn-project-sync
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/analog-canvas/current-formal/sync-tick.py --credentials %d --state /var/lib/canvas-cn-project-sync/monitor.json
TimeoutStartSec=100
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
