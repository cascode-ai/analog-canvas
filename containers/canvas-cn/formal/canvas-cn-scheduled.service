[Unit]
Description=Run Production's scheduled Canvas work in the regional runtime
After=canvas-cn-formal.service
Requisite=canvas-cn-formal.service

[Service]
Type=oneshot
User=canvas-formal
Group=canvas-formal
LoadCredential=sync-admin-token:/etc/analog-canvas-formal/sync-admin-token
ExecStart=/usr/bin/python3 /opt/analog-canvas/current-formal/scheduled-tick.py --credentials %d
TimeoutStartSec=280
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
