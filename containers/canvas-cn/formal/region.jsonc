// The China runtime's differences from wrangler.jsonc (docs/deployment.md,
// "China region"). Every exclusion carries its reason.
{
  "entry": "worker/regional-entry.ts",
  "listen": "127.0.0.1:8792",
  "assets": "127.0.0.1:8083",
  "state": "/var/lib/analog-canvas-formal/state",
  "artifactState": "/var/lib/analog-canvas-formal/artifacts",
  // Durable Object namespace keys are persistent identities: changing one
  // opens an empty store. AUTH is served by the regional session store, which
  // authorizes locally against the overseas account authority.
  "namespaces": {
    "AUTH": {
      "class": "RegionalSessionDO",
      "key": "canvas-cn-formal-session-v1",
      "reason": "Regional sessions lease identity from the overseas authority."
    },
    "GALLERY": { "class": "GalleryDO", "key": "canvas-cn-formal-gallery-v1" },
    "COMPONENT_LIBRARY": {
      "class": "ComponentLibraryDO",
      "key": "canvas-cn-formal-components-v1"
    },
    "AGENT_SESSION": {
      "class": "AgentSessionDO",
      "key": "canvas-cn-formal-agent-v1"
    },
    "SIMULATION_CONTROL": {
      "class": "SimulationControlDO",
      "key": "canvas-cn-formal-simulation-v1"
    },
    "TOPOLOGY_TASK": {
      "class": "TopologyTaskDO",
      "key": "canvas-cn-formal-topology-v1"
    },
    "ANALYTICS": {
      "class": "AnalyticsDO",
      "key": "canvas-cn-formal-analytics-v1"
    }
  },
  // R2 is served by the pinned R2-compatible storage modules
  // (prepare-artifacts.mjs), private to this process.
  "buckets": { "SIMULATION_ARTIFACTS": "artifact-entry" },
  // Production upstream URLs reach the dedicated regional gateways through the
  // loopback operator tunnel. A URL path (SG13G2's /sg13g2) is kept.
  "operators": {
    "ngspice": { "address": "127.0.0.1:19094" },
    "vacask": { "address": "127.0.0.1:19095" }
  },
  "upstreams": {
    "SIMULATION_UPSTREAM_URL": "ngspice",
    "SG13G2_UPSTREAM_URL": "ngspice",
    "VACASK_UPSTREAM_URL": "vacask"
  },
  // Production configuration the region deliberately does not carry.
  "excluded": {
    "services.ARENA": "AnalogArena trusts only Production's binding (docs/specs/analog-arena.md).",
    "queues.SIMULATION_JOBS": "Both regions dispatch by alarm (SIMULATION_DISPATCH); the queue carries no work.",
    "routes": "Public hostnames and ICP-filed routing are host configuration, not bindings.",
    "observability": "Cloudflare-only logging; the host keeps the systemd journal.",
    "workers_dev": "Cloudflare-only preview hostname.",
    "migrations": "Cloudflare class migrations; workerd namespaces are declared above."
  },
  // Region-only text bindings (identical on every regional host).
  "text": {
    "PROJECTS_STORE_NAME": "gallery",
    "PROJECT_REGION": "cn",
    "RESOURCE_REGION": "cn",
    "PROJECT_SYNC_PULL": "true",
    "PROJECT_SYNC_MAX_BYTES": "1073741824"
  },
  // Region-only Durable Object aliases.
  "aliases": { "PROJECTS": "GalleryDO" },
  // Secrets and host-local switches, one root-owned credential file each
  // (canvas-cn-formal.service LoadCredential). Switches hold `true` or
  // `false`, so every host runs the same release bytes.
  "credentials": {
    "SIMULATION_SMOKE_TOKEN": "simulation-smoke-token",
    "SIMULATION_UPSTREAM_TOKEN": "operator-token",
    "VACASK_UPSTREAM_TOKEN": "operator-token",
    "RESOURCE_SYNC_TOKEN": "resource-inbound-token",
    "RESOURCE_SYNC_ADMIN_TOKEN": "resource-admin-token",
    "PROJECT_REGION_USERS": "project-region-users.json",
    "PROJECT_PROTECTED_IDS": "project-protected-ids.json",
    "AUTH_REGIONAL_CLIENT": "regional-client.json",
    "PROJECT_SYNC_TOKEN": "sync-inbound-token",
    "PROJECT_SYNC_PEER_URL": "peer-origin",
    "PROJECT_SYNC_PEER_TOKEN": "sync-outbound-token",
    "PROJECT_SYNC_ADMIN_TOKEN": "sync-admin-token",
    "PROJECT_IDENTITY_URL": "identity-url",
    "PROJECT_IDENTITY_TOKEN": "identity-token",
    "PROJECT_WRITES_ENABLED": "project-writes-enabled",
    "RESOURCE_WRITES_ENABLED": "resource-writes-enabled"
  }
}
