  "+#include \"devswitch.h\"",
  "+#include <cmath>",
  "+#include \"simulator.h\"",
  "+",
  "+namespace NAMESPACE {",
  "+",
  "+template<> int Introspection<DevSwitchInstanceParams>::setup() {",
  "+    registerNamedMember(mfactor, \"$mfactor\");",
  "+    registerMember(ron);",
  "+    registerMember(roff);",
  "+    registerMember(vt);",
  "+    return 0;",
  "+}",
  "+instantiateIntrospection(DevSwitchInstanceParams);",
  "+DevSwitchInstanceParams::DevSwitchInstanceParams() {}",
  "+",
  "+template<> int Introspection<DevSwitchInstanceData>::setup() {",
  "+    registerMember(ctl);",
  "+    registerMember(v);",
  "+    registerMember(i);",
  "+    return 0;",
  "+}",
  "+instantiateIntrospection(DevSwitchInstanceData);",
  "+DevSwitchInstanceData::DevSwitchInstanceData() {}",
  "+",
  "+template<> void BuiltinSwitch::defineInternals() {",
  "+    nodeIds = { \"p\", \"n\", \"cp\", \"cn\" };",
  "+    terminalCount = 4;",
  "+}",
  "+template<> const Device::Flags BuiltinSwitch::extraFlags = static_cast<Device::Flags>(0);",
  "+",
  "+template<> bool BuiltinSwitchInstance::buildHierarchy(Circuit& circuit, RpnEvaluator& evaluator, InstantiationData& idata, Status& s) {",
  "+    const auto& p = params.core();",
  "+    if (!(p.ron>0) || !(p.roff>0) ||",
  "+        !std::isfinite(p.ron) || !std::isfinite(p.roff) || !std::isfinite(p.vt)) {",
  "+        s.set(Status::Range, \"Hard switch resistances must be positive and all parameters finite.\");",
  "+        return false;",
  "+    }",
  "+    return verifyTerminalsConnected(s);",
  "+}",
  "+",
  "+template<> std::tuple<bool, OutputSource> BuiltinSwitchInstance::outvarOutputSource(ParameterIndex ndx) const {",
  "+    switch (ndx) {",
  "+    case 0: return {true, OutputSource(&data.core().ctl)};",
  "+    case 1: return {true, OutputSource(&data.core().v)};",
  "+    case 2: return {true, OutputSource(&data.core().i)};",
  "+    default: return {false, OutputSource()};",
  "+    }",
  "+}",
  "+",
  "+template<> bool BuiltinSwitchInstance::setStaticTolerancesCore(Circuit& circuit, CommonData& commons, Status& s) {",
  "+    const auto& options = circuit.simulatorOptions().core();",
  "+    for (NodeIndex i=0; i<4; i++)",
  "+        updatePotentialNodeSpiceTolerances(options, commons, nodes_[i]->unknownIndex());",
  "+    return true;",
  "+}",
  "+",
  "+template<> bool BuiltinSwitchInstance::populateStructuresCore(Circuit& circuit, Status& s) {",
  "+    for (NodeIndex row=0; row<2; row++)",
  "+        for (NodeIndex col=0; col<2; col++)",
  "+            if (auto [_, ok] = circuit.createJacobianEntry(nodes_[row], nodes_[col], EntryFlags::Resistive, s); !ok)",
  "+                return false;",
  "+    data.core().history = circuit.allocateStates(2);",
  "+    circuit.newResistiveContribution(nodes_[0]);",
  "+    circuit.newResistiveContribution(nodes_[1]);",
  "+    return true;",
  "+}",
  "+",
  "+template<> bool BuiltinSwitchInstance::bindCore(",
  "+    Circuit& circuit,",
  "+    CSCMatrixAccess* matResist, Component compResist, const std::optional<MatrixEntryPosition>& mepResist,",
  "+    CSCMatrixAccess* matReact, Component compReact, const std::optional<MatrixEntryPosition>& mepReact,",
  "+    DelayLines* delayLines, ErrorConsumer& errors",
  "+) {",
  "+    auto& d = data.core();",
  "+    d.uP = nodes_[0]->unknownIndex();",
  "+    d.uN = nodes_[1]->unknownIndex();",
  "+    d.uCp = nodes_[2]->unknownIndex();",
  "+    d.uCn = nodes_[3]->unknownIndex();",
  "+    if (matResist) {",
  "+        jacEntryPtr(d.jacPP, d.uP, d.uP, matResist, compResist, mepResist);",
  "+        jacEntryPtr(d.jacPN, d.uP, d.uN, matResist, compResist, mepResist);",
  "+        jacEntryPtr(d.jacNP, d.uN, d.uP, matResist, compResist, mepResist);",
  "+        jacEntryPtr(d.jacNN, d.uN, d.uN, matResist, compResist, mepResist);",
  "+    }",
  "+    return true;",
  "+}",
  "+",
  "+template<> bool BuiltinSwitchInstance::evalCore(Circuit& circuit, CommonData& commons, EvalSetup& evalSetup, ErrorConsumer& errors) {",
  "+    const auto& p = params.core();",
  "+    auto& d = data.core();",
  "+    d.ctl = evalSetup.oldSolution[d.uCp] - evalSetup.oldSolution[d.uCn];",
  "+    d.v = evalSetup.oldSolution[d.uP] - evalSetup.oldSolution[d.uN];",
  "+    bool closed = d.ctl>p.vt;",
  "+    if (evalSetup.hardSwitchProjectionSide<0) {",
  "+        closed = evalSetup.states->data(1)[d.history]>p.vt;",
  "+    } else if (evalSetup.hardSwitchProjectionSide>0) {",
  "+        const auto& actual = *evalSetup.hardSwitchProjectionSolution;",
  "+        closed = actual[d.uCp]-actual[d.uCn]>p.vt;",
  "+    }",
  "+    d.conductance = 1/(closed ? p.ron : p.roff);",
  "+    d.i = d.conductance*d.v;",
  "+    d.flowResidual = p.mfactor*d.i;",
  "+    if (evalSetup.newStates) {",
  "+        evalSetup.newStates[d.history] = d.ctl;",
  "+        evalSetup.newStates[d.history+1] = evalSetup.time;",
  "+    }",
  "+    if (evalSetup.tranAnalysis && evalSetup.states && !evalSetup.hardSwitchProjectionSide) {",
  "+        const auto* past = evalSetup.states->data(1);",
  "+        const auto previous = past[d.history];",
  "+        const auto previousTime = past[d.history+1];",
  "+        if (evalSetup.time>previousTime && (d.ctl>p.vt)!=(previous>p.vt)) {",
  "+            const auto crossing = previousTime + (evalSetup.time-previousTime)*(p.vt-previous)/(d.ctl-previous);",
  "+            evalSetup.hardSwitchCrossing = std::min(evalSetup.hardSwitchCrossing, crossing);",
  "+        }",
  "+    }",
  "+    return true;",
  "+}",
  "+",
  "+template<> bool BuiltinSwitchInstance::loadCore(Circuit& circuit, CommonData& commons, LoadSetup& loadSetup, ErrorConsumer& errors) {",
  "+    const auto& p = params.core();",
  "+    const auto& d = data.core();",
  "+    const auto gain = p.mfactor*d.conductance;",
  "+    if (loadSetup.loadResistiveJacobian || loadSetup.loadTransientJacobian) {",
  "+        *(d.jacPP+loadSetup.jacobianLoadOffset) += gain;",
  "+        *(d.jacPN+loadSetup.jacobianLoadOffset) -= gain;",
  "+        *(d.jacNP+loadSetup.jacobianLoadOffset) -= gain;",
  "+        *(d.jacNN+loadSetup.jacobianLoadOffset) += gain;",
  "+    }",
  "+    if (loadSetup.resistiveResidual) {",
  "+        loadSetup.resistiveResidual[d.uP] += d.flowResidual;",
  "+        loadSetup.resistiveResidual[d.uN] -= d.flowResidual;",
  "+    }",
  "+    if (loadSetup.maxResistiveResidualContribution) {",
  "+        const auto flow = std::abs(d.flowResidual);",
  "+        loadSetup.maxResistiveResidualContribution[d.uP] = std::max(loadSetup.maxResistiveResidualContribution[d.uP], flow);",
  "+        loadSetup.maxResistiveResidualContribution[d.uN] = std::max(loadSetup.maxResistiveResidualContribution[d.uN], flow);",
  "+    }",
  "+    return true;",
  "+}",
  "+",
  "+}"
]
