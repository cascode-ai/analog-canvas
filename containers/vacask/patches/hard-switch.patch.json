  "+        std::vector<UnknownIndex> singleColumn(jac.nRow(), 0);",
  "+        std::vector<unsigned> rowCount(jac.nRow(), 0);",
  "+        std::vector<bool> fixed(jac.nRow()+1, false);",
  "+        for (UnknownIndex i=1; i<=jac.nRow(); i++)",
  "+            fixed[i] = circuit.hasReactiveContribution(i);",
  "+        for (UnknownIndex col=0; col<jac.nRow(); col++) {",
  "+            for (auto k=ap[col]; k<ap[col+1]; k++) {",
  "+                if (ax[k]!=0) {",
  "+                    singleColumn[ai[k]] = col+1;",
  "+                    rowCount[ai[k]]++;",
