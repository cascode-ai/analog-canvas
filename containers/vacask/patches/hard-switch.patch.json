  "+bool TranNRSolver::hardSwitchPredictorJump(const RealVector& prediction, RealVector& jump, ErrorConsumer& errors) {",
  "+    const auto actual = solution.vector();",
  "+    const auto actualFuture = solution.futureVector();",
  "+    const auto actualStates = states.vector();",
  "+    const auto actualFutureStates = states.futureVector();",
  "+    const auto actualDeviceStates = deviceStates;",
  "+    const auto setup = evalSetup_;",
  "+    bool ok = true;",
  "+    RealVector before;",
  "+    projectionValues = &prediction;",
  "+    for (const auto side : {-1, 1}) {",
  "+        solution.vector() = prediction;",
  "+        states.vector() = actualStates;",
  "+        states.futureVector() = actualFutureStates;",
  "+        deviceStates = actualDeviceStates;",
  "+        evalSetup_ = setup;",
  "+        evalSetup_.hardSwitchProjectionSolution = &actual;",
  "+        evalSetup_.hardSwitchProjectionSide = side;",
  "+        if (!run(true, errors)) {",
  "+            ok = false;",
  "+            break;",
  "+        }",
  "+        if (side<0) {",
  "+            before = solution.vector();",
  "+        } else {",
  "+            jump = solution.vector();",
  "+            for (UnknownIndex i=0; i<jump.size(); i++) {",
  "+                jump[i] -= before[i];",
  "+                if (i==0 || circuit.hasReactiveContribution(i)) jump[i] = 0;",
  "+            }",
  "+        }",
  "+    }",
  "+    // Projections never become accepted points. Restore scratch and re-evaluate",
  "+    // the actual circuit to refresh outputs, Jacobian, maxima and requests.",
  "+    projectionValues = nullptr;",
  "+    solution.vector() = actual;",
  "+    solution.futureVector() = actualFuture;",
  "+    states.vector() = actualStates;",
  "+    states.futureVector() = actualFutureStates;",
  "+    deviceStates = actualDeviceStates;",
  "+    evalSetup_ = setup;",
  "+    evalSetup_.hardSwitchProjectionSolution = &actual; // disable bypass",
  "+    const bool restored = run(true, errors);",
  "+    evalSetup_.hardSwitchProjectionSolution = nullptr;",
  "+    evalSetup_.hardSwitchProjectionSide = 0;",
  "+    return ok && restored;",
  "+}",
  "+",
