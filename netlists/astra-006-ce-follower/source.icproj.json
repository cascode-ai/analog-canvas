  "simulationFolders": [
    {
      "id": "verify",
      "input": {
        "circuitBindings": [
          {
            "documentId": "document-main",
            "emission": "subcircuit",
            "id": "circuit",
            "path": "circuit.spice"
          }
        ],
        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "Common-emitter amplifier with output buffer — nominal functional verification\n.include \"circuit.spice\"\n.include \"models.spice\"\nVCC vcc 0 12\nVIN in 0 DC 0 AC 1 SIN(0 1m 1k)\nXDUT vcc 0 in out astra_006_ce_follower\n.temp 27\n* @spec gain_1khz range 40 49 unit=dB\n* @spec out_pp range 0.2 0.6 unit=V\n* @spec supply_avg range 0.002 0.006 unit=A\n.control\nset filetype=ascii\nset appendwrite\nset wr_singlescale\nset wr_vecnames\nop\nprint v(out) i(vcc)\nac dec 80 1 100Meg\nlet gain=db(v(out))\nmeas ac gain_1khz FIND gain AT=1000\nwrdata ac.dat v(out)\nwrite out.raw v(out)\ntran 2u 30m\nlet supply=-i(vcc)\nmeas tran out_pp PP v(out) FROM=20m TO=30m\nmeas tran supply_avg AVG supply FROM=20m TO=30m\nwrdata transient.dat v(in) v(out)\nwrite out.raw v(in) v(out)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
          {
            "path": "models.spice",
            "text": "* Educational generic models by GPT-6-Astra. Not vendor or foundry models.\n* Nominal 27 C; intended for topology/function demonstrations, not signoff.\n.model ANPN NPN(IS=1e-15 BF=150 VAF=100 IKF=0.1 RB=20 RC=1 RE=0.2 CJE=8p CJC=3p TF=300p TR=20n)\n.model APNP PNP(IS=1e-15 BF=100 VAF=80 IKF=0.1 RB=30 RC=1 RE=0.2 CJE=10p CJC=4p TF=500p TR=30n)\n.model ANMOS NMOS(LEVEL=1 VTO=0.6 KP=200u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model APMOS PMOS(LEVEL=1 VTO=-0.6 KP=80u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model AD D(IS=2n N=1.8 RS=0.5 CJO=2p TT=4n)\n"
          }
        ],
        "kind": "source"
      },
      "name": "Functional verification — ngspice",
      "version": 4
