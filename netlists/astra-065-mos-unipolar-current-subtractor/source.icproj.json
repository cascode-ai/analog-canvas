        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "MOS unipolar current-subtraction cell\n.include \"circuit.spice\"\n.include \"models.spice\"\nVDD vdd 0 3.3\nIA 0 i1 PWL(0 40u 190n 40u 200n 60u 390n 60u 400n 30u 590n 30u 600n 20u 800n 20u)\nIB 0 i2 PWL(0 20u 390n 20u 400n 60u 590n 60u 600n 80u 800n 80u)\nXDUT vdd 0 i1 i2 out astra_065_mos_unipolar_current_subtractor\n.temp 27\n.options method=gear reltol=1e-5\n* @spec positive1 range 0.88 1.12 unit=V\n* @spec positive2 range 1.8 2.2 unit=V\n* @spec negative1 range 0 0.08 unit=V\n* @spec negative2 range 0 0.08 unit=V\n.control\nset filetype=ascii\ntran 100p 800n\nmeas tran positive1 FIND v(out) AT=150n\nmeas tran positive2 FIND v(out) AT=350n\nmeas tran negative1 FIND v(out) AT=550n\nmeas tran negative2 FIND v(out) AT=750n\nwrite out.raw v(out) v(i1) v(i2)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
