  "simulationFolders": [
    {
      "id": "verify",
      "input": {
        "circuitBindings": [
          {
            "documentId": "document-main",
            "emission": "subcircuit",
            "id": "circuit",
            "path": "circuit.spice"
          }
        ],
        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "MOS common-gate Colpitts oscillator\n.include \"circuit.spice\"\n.include \"models.spice\"\nVDD vdd 0 3.3\nVG vg 0 1.8\nVB vb 0 .9\n.ic v(tank)=3.3 v(fb)=.85\nXDUT vdd 0 vg vb tank fb out astra_067_mos_common_gate_colpitts_oscillator\n.temp 27\n.options method=gear reltol=1e-5\n* @spec tankpp range 0.2 10 unit=V\n* @spec outpp range 0.1 4 unit=V\n* @spec period range 5e-9 5e-8 unit=s\n* @spec avg range 3 3.5 unit=V\n.control\nset filetype=ascii\ntran 100p 5u\nmeas tran tankpp PP v(tank) FROM=3u TO=5u\nmeas tran outpp PP v(out) FROM=3u TO=5u\nmeas tran period TRIG v(tank) VAL=3.3 RISE=100 TARG v(tank) VAL=3.3 RISE=101\nmeas tran avg AVG v(tank) FROM=3u TO=5u\nwrite out.raw v(tank) v(out)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
          {
            "path": "models.spice",
            "text": "* Educational generic models by GPT-6-Astra. Not vendor or foundry models.\n* Nominal 27 C; intended for topology/function demonstrations, not signoff.\n.model ANPN NPN(IS=1e-15 BF=150 VAF=100 IKF=0.1 RB=20 RC=1 RE=0.2 CJE=8p CJC=3p TF=300p TR=20n)\n.model APNP PNP(IS=1e-15 BF=100 VAF=80 IKF=0.1 RB=30 RC=1 RE=0.2 CJE=10p CJC=4p TF=500p TR=30n)\n.model ANMOS NMOS(LEVEL=1 VTO=0.6 KP=200u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model APMOS PMOS(LEVEL=1 VTO=-0.6 KP=80u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model AD D(IS=2n N=1.8 RS=0.5 CJO=2p TT=4n)\n"
          }
        ],
        "kind": "source"
      },
      "name": "Functional verification — ngspice",
