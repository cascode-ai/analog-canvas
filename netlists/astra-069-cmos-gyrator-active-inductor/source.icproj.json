  "simulationFolders": [
    {
      "id": "verify",
      "input": {
        "circuitBindings": [
          {
            "documentId": "document-main",
            "emission": "subcircuit",
            "id": "circuit",
            "path": "circuit.spice"
          }
        ],
        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "CMOS biased gyrator-C active inductor\n.include \"circuit.spice\"\n.include \"models.spice\"\nVDD vdd 0 3.3\nVB vb 0 1.8\nIR iref 0 20u\nIP 0 ind DC 300u AC 1\nXDUT vdd 0 iref vb x ind astra_069_cmos_gyrator_active_inductor\n.temp 27\n.options method=gear reltol=1e-5\n* @spec m1_margin range 0.02 1 unit=V\n* @spec m2_margin range 0.02 0.5 unit=V\n* @spec port_bias range 0.8 1.2 unit=V\n* @spec resistance range 0 250 unit=ohm\n* @spec react100 range 20 150 unit=ohm\n* @spec react500 range 100 750 unit=ohm\n* @spec l100 range 0.00006 0.00013 unit=H\n* @spec l500 range 0.00006 0.00013 unit=H\n.control\nset filetype=ascii\ndc IP 300u 301u 1u\nmeas dc port_bias FIND v(ind) AT=300u\nlet margin2=v(ind)-(v(x)-.6)\nlet margin1=v(x)-1.8+.6+.4*(sqrt(.7+v(ind))-sqrt(.7))\nmeas dc m1_margin FIND margin1 AT=300u\nmeas dc m2_margin FIND margin2 AT=300u\nac dec 30 100k 100Meg\nlet zr=real(v(ind))\nlet zi=imag(v(ind))\nlet induct=zi/(2*3.141592653589793*frequency)\nmeas ac resistance FIND zr AT=100k\nmeas ac react100 FIND zi AT=100k\nmeas ac react500 FIND zi AT=500k\nmeas ac l100 FIND induct AT=100k\nmeas ac l500 FIND induct AT=500k\nwrite out.raw v(ind)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
          {
            "path": "models.spice",
            "text": "* Educational generic models by GPT-6-Astra. Not vendor or foundry models.\n* Nominal 27 C; intended for topology/function demonstrations, not signoff.\n.model ANPN NPN(IS=1e-15 BF=150 VAF=100 IKF=0.1 RB=20 RC=1 RE=0.2 CJE=8p CJC=3p TF=300p TR=20n)\n.model APNP PNP(IS=1e-15 BF=100 VAF=80 IKF=0.1 RB=30 RC=1 RE=0.2 CJE=10p CJC=4p TF=500p TR=30n)\n.model ANMOS NMOS(LEVEL=1 VTO=0.6 KP=200u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model APMOS PMOS(LEVEL=1 VTO=-0.6 KP=80u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model AD D(IS=2n N=1.8 RS=0.5 CJO=2p TT=4n)\n"
          }
        ],
        "kind": "source"
      },
