        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "MOS high-side current limiter\n.include \"circuit.spice\"\n.include \"models.spice\"\nVDD vdd 0 3.3\nBLOAD out 0 I=v(out)*(0.001+0.009*u(time-2u)+0.09*u(time-4u))\nXDUT vdd 0 out sense astra_072_mos_high_side_current_limiter\n.temp 27\n.options method=gear reltol=1e-5\n* @spec normal_voltage range 2.8 3.2 unit=V\n* @spec overload range 0.0055 0.0075 unit=A\n* @spec short_current range 0.0055 0.0075 unit=A\n* @spec overload_voltage range 0.55 0.75 unit=V\n* @spec short_voltage range 0.055 0.075 unit=V\n.control\nset filetype=ascii\ntran 1n 6u\nlet current=(v(vdd)-v(sense))/100\nmeas tran normal_voltage FIND v(out) AT=1.5u\nmeas tran overload FIND current AT=3.5u\nmeas tran short_current FIND current AT=5.5u\nmeas tran overload_voltage FIND v(out) AT=3.5u\nmeas tran short_voltage FIND v(out) AT=5.5u\nwrite out.raw v(out) v(sense) v(vdd)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
          {
            "path": "models.spice",
            "text": "* Educational generic models by GPT-6-Astra. Not vendor or foundry models.\n* Nominal 27 C; intended for topology/function demonstrations, not signoff.\n.model ANPN NPN(IS=1e-15 BF=150 VAF=100 IKF=0.1 RB=20 RC=1 RE=0.2 CJE=8p CJC=3p TF=300p TR=20n)\n.model APNP PNP(IS=1e-15 BF=100 VAF=80 IKF=0.1 RB=30 RC=1 RE=0.2 CJE=10p CJC=4p TF=500p TR=30n)\n.model ANMOS NMOS(LEVEL=1 VTO=0.6 KP=200u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model APMOS PMOS(LEVEL=1 VTO=-0.6 KP=80u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model AD D(IS=2n N=1.8 RS=0.5 CJO=2p TT=4n)\n"
          }
        ],
