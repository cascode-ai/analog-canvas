  "simulationFolders": [
    {
      "id": "verify",
      "input": {
        "circuitBindings": [
          {
            "documentId": "document-main",
            "emission": "subcircuit",
            "id": "circuit",
            "path": "circuit.spice"
          }
        ],
        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "MOS full-wave current rectifier\n.include \"circuit.spice\"\n.include \"models.spice\"\nVDD vdd 0 1.8\nVEE vee 0 -1.8\nVOUT out 0 1.2\nIIN 0 iin PWL(0 5u 10u 5u 10.01u -5u 20u -5u 20.01u 15u 30u 15u 30.01u -15u 40u -15u 40.01u 30u 50u 30u 50.01u -30u 60u -30u 60.01u 0 70u 0)\nXDUT vdd vee 0 iin out astra_082_mos_full_wave_current_rectifier\n.temp 27\n.options method=gear reltol=1e-5\n* @spec abs0 range 0.0000047 0.000005600000000000001 unit=A\n* @spec abs1 range 0.0000047 0.000005600000000000001 unit=A\n* @spec abs2 range 0.000014099999999999999 0.000016800000000000002 unit=A\n* @spec abs3 range 0.000014099999999999999 0.000016800000000000002 unit=A\n* @spec abs4 range 0.000028199999999999998 0.000033600000000000004 unit=A\n* @spec abs5 range 0.000028199999999999998 0.000033600000000000004 unit=A\n* @spec zero range 0 1e-8 unit=A\n.control\nset filetype=ascii\ntran 5n 70u\nlet io=-i(VOUT)\nmeas tran abs0 FIND io AT=7u\nmeas tran abs1 FIND io AT=17u\nmeas tran abs2 FIND io AT=27u\nmeas tran abs3 FIND io AT=37u\nmeas tran abs4 FIND io AT=47u\nmeas tran abs5 FIND io AT=57u\nmeas tran zero FIND io AT=67u\nwrite out.raw v(iin) v(xdut.net0) i(vout)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
          {
            "path": "models.spice",
            "text": "* Educational generic models by GPT-6-Astra. Not vendor or foundry models.\n* Nominal 27 C; intended for topology/function demonstrations, not signoff.\n.model ANPN NPN(IS=1e-15 BF=150 VAF=100 IKF=0.1 RB=20 RC=1 RE=0.2 CJE=8p CJC=3p TF=300p TR=20n)\n.model APNP PNP(IS=1e-15 BF=100 VAF=80 IKF=0.1 RB=30 RC=1 RE=0.2 CJE=10p CJC=4p TF=500p TR=30n)\n.model ANMOS NMOS(LEVEL=1 VTO=0.6 KP=200u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model APMOS PMOS(LEVEL=1 VTO=-0.6 KP=80u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model AD D(IS=2n N=1.8 RS=0.5 CJO=2p TT=4n)\n"
          }
        ],
        "kind": "source"
      },
