    {
      "id": "verify",
      "input": {
        "circuitBindings": [
          {
            "documentId": "document-main",
            "emission": "subcircuit",
            "id": "circuit",
            "path": "circuit.spice"
          }
        ],
        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "CMOS current-programmed floating resistor\n.include \"circuit.spice\"\n.include \"models.spice\"\nVDD vdd 0 3.3\nVOUT out 0 1.65\nVIN vin 0 1.65\nI1 vdd gn 5u\nI2 gp 0 5u\nXDUT vdd 0 vin out gn gp astra_087_cmos_current_programmed_resistor\n.temp 27\n.options method=gear reltol=1e-5\n* @spec ip0 range 0.000011627906976744187 0.000016666666666666667 unit=A\n* @spec in0 range -0.000016666666666666667 -0.000011627906976744187 unit=A\n* @spec ip1 range 0.00002272727272727273 0.000033333333333333335 unit=A\n* @spec in1 range -0.000033333333333333335 -0.00002272727272727273 unit=A\n* @spec ip2 range 0.00004545454545454546 0.00006666666666666667 unit=A\n* @spec in2 range -0.00006666666666666667 -0.00004545454545454546 unit=A\n.control\nset filetype=ascii\nalter I1 5u\nalter I2 5u\ndc VIN 1.59 1.71 .002\nlet conduct=-i(VIN)\nmeas dc ip0 FIND conduct AT=1.7\nmeas dc in0 FIND conduct AT=1.6\nlet rp0=.05/ip0\nlet rn0=-.05/in0\nprint rp0 rn0\nalter I1 20u\nalter I2 20u\ndc VIN 1.59 1.71 .002\nlet conduct=-i(VIN)\nmeas dc ip1 FIND conduct AT=1.7\nmeas dc in1 FIND conduct AT=1.6\nlet rp1=.05/ip1\nlet rn1=-.05/in1\nprint rp1 rn1\nalter I1 80u\nalter I2 80u\ndc VIN 1.59 1.71 .002\nlet conduct=-i(VIN)\nmeas dc ip2 FIND conduct AT=1.7\nmeas dc in2 FIND conduct AT=1.6\nlet rp2=.05/ip2\nlet rn2=-.05/in2\nprint rp2 rn2\n\n\nwrite out.raw v(vin) i(vin) v(gn) v(gp)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
          {
            "path": "models.spice",
            "text": "* Educational generic models by GPT-6-Astra. Not vendor or foundry models.\n* Nominal 27 C; intended for topology/function demonstrations, not signoff.\n.model ANPN NPN(IS=1e-15 BF=150 VAF=100 IKF=0.1 RB=20 RC=1 RE=0.2 CJE=8p CJC=3p TF=300p TR=20n)\n.model APNP PNP(IS=1e-15 BF=100 VAF=80 IKF=0.1 RB=30 RC=1 RE=0.2 CJE=10p CJC=4p TF=500p TR=30n)\n.model ANMOS NMOS(LEVEL=1 VTO=0.6 KP=200u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model APMOS PMOS(LEVEL=1 VTO=-0.6 KP=80u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model AD D(IS=2n N=1.8 RS=0.5 CJO=2p TT=4n)\n"
          }
        ],
        "kind": "source"
      },
