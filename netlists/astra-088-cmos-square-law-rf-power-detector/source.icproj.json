  "simulationFolders": [
    {
      "id": "verify",
      "input": {
        "circuitBindings": [
          {
            "documentId": "document-main",
            "emission": "subcircuit",
            "id": "circuit",
            "path": "circuit.spice"
          }
        ],
        "configPath": "experiment.json",
        "dependencies": [],
        "entry": "run.cir",
        "files": [
          {
            "path": "run.cir",
            "text": "CMOS square-law RF power detector\n.include \"circuit.spice\"\n.include \"models.spice\"\nVDD vdd 0 3.3\nBP vp 0 V=1+(time<100u?0:(time<200u?.1:(time<300u?.2:.3)))*sin(2*pi*1Meg*time)\nBN vn 0 V=1-(time<100u?0:(time<200u?.1:(time<300u?.2:.3)))*sin(2*pi*1Meg*time)\nXDUT vdd 0 vp vn out astra_088_cmos_square_law_rf_power_detector\n.temp 27\n.options method=gear reltol=1e-5\n* @spec baseline range 0.32 0.38 unit=V\n* @spec power1 range 0.009 0.013 unit=V\n* @spec power2 range 0.038 0.05 unit=V\n* @spec power3 range 0.087 0.112 unit=V\n* @spec ripple range 0 0.005 unit=V\n.control\nset filetype=ascii\ntran 10n 400u\nmeas tran baseline AVG v(out) FROM=60u TO=90u\nlet excess=v(out)-baseline\nmeas tran power1 AVG excess FROM=160u TO=190u\nmeas tran power2 AVG excess FROM=260u TO=290u\nmeas tran power3 AVG excess FROM=360u TO=390u\nmeas tran ripple PP v(out) FROM=360u TO=390u\nwrite out.raw v(out) v(vp) v(vn)\nquit\n.endc\n.end\n"
          },
          {
            "path": "experiment.json",
            "text": "{\n  \"version\": 2,\n  \"environment\": {\n    \"profileId\": \"sky130-core-continuous-ngspice46-v1\"\n  }\n}\n"
          },
          {
            "path": "models.spice",
            "text": "* Educational generic models by GPT-6-Astra. Not vendor or foundry models.\n* Nominal 27 C; intended for topology/function demonstrations, not signoff.\n.model ANPN NPN(IS=1e-15 BF=150 VAF=100 IKF=0.1 RB=20 RC=1 RE=0.2 CJE=8p CJC=3p TF=300p TR=20n)\n.model APNP PNP(IS=1e-15 BF=100 VAF=80 IKF=0.1 RB=30 RC=1 RE=0.2 CJE=10p CJC=4p TF=500p TR=30n)\n.model ANMOS NMOS(LEVEL=1 VTO=0.6 KP=200u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model APMOS PMOS(LEVEL=1 VTO=-0.6 KP=80u GAMMA=0.4 PHI=0.7 LAMBDA=0.02 CGSO=200p CGDO=200p CJ=100u CJSW=300p)\n.model AD D(IS=2n N=1.8 RS=0.5 CJO=2p TT=4n)\n"
          }
        ],
        "kind": "source"
      },
      "name": "Functional verification — ngspice",
