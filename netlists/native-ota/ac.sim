OTA open-loop AC
// 1. Edit the frequency range or sources on Canvas; the folder requests its corner Profile.
// 2. Click Run.
// 3. Plot Gain in dB/phase; Measurements reports DC gain and first falling unity crossing.
ground 0
include "models/library.inc"
include "circuit.spice"
control
abort always
options rawfile="ascii" strictsave=2 temp=27 reltol=1e-8 abstol=1e-12 vntol=1e-10
save v(vinp) v(vout)
// AC is a small-signal response, not an output-swing test.
analysis frequency ac from=1 to=1G mode="dec" points=60
postprocess(PYTHON,"report.py","ota-ac")
endc
