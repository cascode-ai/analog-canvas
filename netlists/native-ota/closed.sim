OTA unity feedback AC and step
// 1. Edit the DUT on Canvas; edit sources, load and feedback in testbench.spice.
// 2. Click Run.
// 3. Plot closed-loop Gain and step; inspect the requested time-window measurements.
// Only the DUT comes from Canvas; the visible open-loop TB is not instantiated.
ground 0
include "models/library.inc"
include "circuit.spice"
include "testbench.spice"
control
abort always
options rawfile="ascii" strictsave=2 temp=27 reltol=1e-8 abstol=1e-12 vntol=1e-10
save v(vinp) v(vout) i(VDD)
analysis frequency ac from=1 to=1G mode="dec" points=60
analysis step tran stop=6u step=1n maxstep=1n
postprocess(PYTHON,"report.py","ota-closed")
endc
