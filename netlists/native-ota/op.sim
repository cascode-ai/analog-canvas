OTA operating point
// 1. Adjust sources or device parameters on Canvas.
// 2. Click Run.
// 3. Open Operating Point for native model outputs; Measurements reports supply current.
ground 0
include "models/library.inc"
include "circuit.spice"
control
abort always
options rawfile="ascii" strictsave=2 temp=27 reltol=1e-8 abstol=1e-12 vntol=1e-10
// N0001 is the current IR name of the Canvas IBIAS/XDUT.ibias connection.
