{
  "name": "interactive-circuit-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.16.0"
  },
  "dependencies": {
    "@icm/agent-adapter": "workspace:*",
    "@icm/derived": "workspace:*",
    "@icm/model": "workspace:*",
    "@icm/project-protocol": "workspace:*",
    "@icm/render-svg": "workspace:*",
    "@icm/symbols": "workspace:*"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "release:package": "pnpm build && node scripts/package-mcp.mjs && node scripts/package-release.mjs",
    "performance:check": "pnpm build && node scripts/performance-baseline.mjs",
    "export:golden": "pnpm build && node scripts/export-golden.mjs",
    "export:golden:check": "pnpm build && node scripts/export-golden.mjs --check",
    "pwa:icons": "pnpm --filter @icm/exporters build && node scripts/pwa-icons.mjs",
    "pwa:icons:check": "pnpm --filter @icm/exporters build && node scripts/pwa-icons.mjs --check",
    "release:verify:built": "node scripts/performance-baseline.mjs && node scripts/visual-golden.mjs --check && node scripts/export-golden.mjs --check && node scripts/pwa-icons.mjs --check && node scripts/editor-production-smoke.mjs --check && node scripts/package-mcp.mjs && node scripts/package-release.mjs && node scripts/release-smoke.mjs && node scripts/mcp-release-smoke.mjs",
    "release:verify": "pnpm build && pnpm release:verify:built",
    "agent-api:artifacts": "pnpm --filter @icm/agent-adapter... build && node scripts/agent-api-artifacts.mjs",
    "agent-api:artifacts:check": "pnpm --filter @icm/agent-adapter... build && node scripts/agent-api-artifacts.mjs --check",
    "agent-kit:catalog": "node scripts/generate-agent-authoring-catalog.mjs",
    "agent-kit:catalog:check": "node scripts/generate-agent-authoring-catalog.mjs --check",
    "mcp:resources": "pnpm --filter @icm/agent-adapter... build && node scripts/generate-mcp-resources.mjs",
    "mcp:resources:check": "pnpm --filter @icm/agent-adapter... build && node scripts/generate-mcp-resources.mjs --check",
    "mcp:package": "pnpm build && node scripts/package-mcp.mjs",
    "mcp:release:package": "pnpm build && node scripts/package-mcp.mjs --verify-declared-release-sha",
    "mcp:distribution:check": "node scripts/check-mcp-distribution.mjs",
    "mcp:smoke": "node scripts/mcp-release-smoke.mjs",
    "dev": "pnpm --filter @icm/editor dev",
    "gate:plan": "node scripts/gate-plan.mjs",
    "gate:preflight": "node scripts/gate-run.mjs --stage preflight",
    "gate:affected": "node scripts/gate-run.mjs --stage affected",
    "gate:branch": "pnpm verify:branch",
    "gate:full": "pnpm ci:check",
    "ci:static": "pnpm format:check && pnpm docs:check && pnpm references:check && pnpm agent-kit:catalog:check && pnpm mcp:distribution:check && pnpm typecheck",
    "ci:unit": "pnpm test",
    "ci:release": "pnpm exec playwright install --with-deps chromium && pnpm release:verify",
    "ci:e2e": "pnpm build && playwright test",
    "ci:check": "pnpm ci:static && pnpm test:local && pnpm exec playwright install --with-deps chromium && pnpm build && pnpm release:verify:built && pnpm test:e2e:local",
    "verify:branch": "pnpm ci:static && pnpm test:local && pnpm build && node scripts/editor-production-smoke.mjs --check",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,tsx,json}\" \"references/**/*.json\" \"scripts/**/*.mjs\" \"*.{json,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css,html}\" \"packages/**/*.{ts,tsx,json}\" \"references/**/*.json\" \"scripts/**/*.mjs\" \"*.{json,yaml}\"",
    "references:check": "node scripts/check-references.mjs",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "symbols:razavi": "node scripts/generate-razavi-symbol-catalog.mjs",
    "symbols:razavi:check": "node scripts/generate-razavi-symbol-catalog.mjs --check",
    "symbols:razavi-mos": "node scripts/generate-razavi-mos-assets.mjs",
    "symbols:razavi-mos:check": "node scripts/generate-razavi-mos-assets.mjs --check",
    "symbols:razavi-peripherals": "node scripts/generate-razavi-peripheral-assets.mjs",
    "symbols:razavi-peripherals:check": "node scripts/generate-razavi-peripheral-assets.mjs --check",
    "symbols:razavi-inductor": "node scripts/generate-razavi-inductor-asset.mjs",
    "symbols:razavi-inductor:check": "node scripts/generate-razavi-inductor-asset.mjs --check",
    "symbols:razavi-opamp": "node scripts/generate-razavi-opamp-asset.mjs",
    "symbols:razavi-opamp:check": "node scripts/generate-razavi-opamp-asset.mjs --check",
    "symbols:razavi-logic": "node scripts/generate-razavi-logic-gate-assets.mjs",
    "symbols:razavi-logic:check": "node scripts/generate-razavi-logic-gate-assets.mjs --check",
    "symbols:razavi-common": "node scripts/generate-razavi-common-assets.mjs",
    "symbols:razavi-common:check": "node scripts/generate-razavi-common-assets.mjs --check",
    "visual:golden": "pnpm build && node scripts/visual-golden.mjs",
    "visual:golden:check": "pnpm build && node scripts/visual-golden.mjs --check",
    "test": "vitest run",
    "test:local": "vitest run --maxWorkers=2",
    "test:impact": "node scripts/check-test-impact.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --workers=1",
    "test:production-smoke": "pnpm --filter @icm/editor build && node scripts/editor-production-smoke.mjs",
    "test:production-smoke:check": "pnpm --filter @icm/editor build && node scripts/editor-production-smoke.mjs --check",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "pngjs": "^7.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
