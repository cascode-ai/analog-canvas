{
  "name": "@icm/math-typesetting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./profile": {
      "development": "./src/profile.ts",
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.js"
    },
    "./cache": {
