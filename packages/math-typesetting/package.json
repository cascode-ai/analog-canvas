      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3"
  }
}
