{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "devices": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[^/]+\\/[^/]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "omit": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": ["omit"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pins": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "parameters": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "omitPins": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": ["symbol", "pins", "parameters", "omitPins"],
                "additionalProperties": false
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": ["version", "devices"],
  "additionalProperties": false
}
