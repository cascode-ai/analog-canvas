{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@icm/agent-adapter": ["./packages/agent-adapter/src/index.ts"],
      "@icm/agent-routing": ["./packages/agent-routing/src/index.ts"],
      "@icm/derived": ["./packages/derived/src/index.ts"],
      "@icm/edit-engine": ["./packages/edit-engine/src/index.ts"],
      "@icm/exporters": ["./packages/exporters/src/index.ts"],
      "@icm/exporters/browser": ["./packages/exporters/src/browser.ts"],
      "@icm/exporters/node": ["./packages/exporters/src/node.ts"],
      "@icm/model": ["./packages/model/src/index.ts"],
      "@icm/platform-node": ["./packages/platform-node/src/index.ts"],
      "@icm/render-svg": ["./packages/render-svg/src/index.ts"],
      "@icm/spice": ["./packages/spice/src/index.ts"],
      "@icm/symbols": ["./packages/symbols/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "worker/**/*.ts",
    "packages/**/*.ts",
    "vitest.config.ts"
  ]
}
