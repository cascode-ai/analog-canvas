{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // Deliberately not renamed to match the product. A Worker's Durable Object
  // namespaces are keyed to this script name, so renaming it would create
  // empty ones and strand the published gallery, accounts, and analytics in
  // the old script. The public identity is the custom domain below.
  "name": "interactive-circuit-maker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "analog-canvas.tokenzhang.com",
      "custom_domain": true,
    },
    // Regional control traffic keeps this overseas origin when browser DNS splits.
    {
      "pattern": "analog-canvas-origin.tokenzhang.com",
      "custom_domain": true,
    },
    // AnalogArena's own host: this Worker serves the Schematic Arena at
    // /schematic there and sends every other path to Analog Canvas
    // (worker/arena.ts routeArenaHosts, docs/specs/analog-arena.md#hosts).
    {
      "pattern": "chip-arena.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "AGENT_MCP_DOWNLOAD_ORIGIN": "https://analog-canvas.tokenzhang.com",
    "SIMULATION_DISPATCH": "alarm",
    "SIMULATION_UPSTREAM_URL": "https://sim-fra.analog-canvas.tokenzhang.com",
    "SG13G2_UPSTREAM_URL": "https://sim-fra.analog-canvas.tokenzhang.com/sg13g2",
    "SIMULATION_DEFAULT_EXECUTOR": "operator-host",
    // The second engine is selected only by its Profile. It has its own
    // gateway credential and never falls back to the ngspice route.
    "VACASK_UPSTREAM_URL": "https://vacask-preview-sim.tokenzhang.com",
    "VACASK_PROFILE_ID": "vacask-sky130-candidate",
  },
  "assets": {
    // The binding the Worker fetches through. Its absence is what produced
    // error 1101 on 2026-09-01: `env.ASSETS` was undefined, so the moment a
    // request reached the Worker's asset path it threw. Reproduced locally
    // against workerd, and it is the reason the earlier "binding re-entry"
    // explanation was wrong — routing /assets/* through the Worker does not
    // re-enter it.
    "binding": "ASSETS",
    "directory": "./apps/editor/dist",
    // A path under /assets/ names a content-hashed file: the name is a
    // promise about the bytes, so a miss is a miss and must say 404. Any
    // other miss is the shell, which the Worker keeps for the app's pages
    // and turns into 404 for a path no page serves. The asset layer alone
    // answers every miss with the shell at status 200, so a browser
    // expecting JavaScript would get HTML.
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first: /api, the Gallery shell and
    // its direct documents, selection boards, the MCP downloads, the
    // Schematic Arena and Chip Arena pages it forwards, and every other path,
    // where only the Worker can tell a page the app serves
    // (apps/editor/src/page-routes.ts) from a path no page serves, which it
    // answers 404 (#2159). Wrangler refuses a path list holding "/*" beside
    // the paths it covers.
    "run_worker_first": true,
  },
  // AnalogArena (Arcadia-1/chip-arena) has no route of its own: this
  // Worker forwards /schematic… and /api/arena/… to it with the signed-in
  // account, which Arena trusts because only this binding reaches it
  // (docs/specs/analog-arena.md). Only Production holds it.
  "services": [{ "binding": "ARENA", "service": "analog-arena" }],
  // Flood protection for /api/* per client address: 1200 requests a minute,
  // room for a class behind one address (worker/api-rate-limit.ts). The
  // per-account limits stay the real bounds.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "16471",
      "simple": { "limit": 1200, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TOPOLOGY_TASK", "class_name": "TopologyTaskDO" },
      { "name": "COMPONENT_LIBRARY", "class_name": "ComponentLibraryDO" },
      {
        "name": "ANALYTICS",
        "class_name": "AnalyticsDO",
      },
      {
        "name": "AGENT_SESSION",
        "class_name": "AgentSessionDO",
      },
      {
        "name": "GALLERY",
        "class_name": "GalleryDO",
      },
      {
        "name": "AUTH",
        "class_name": "AuthDO",
      },
      {
        "name": "SIMULATION_CONTROL",
        "class_name": "SimulationControlDO",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "REGIONAL_RELEASES",
      "bucket_name": "analog-canvas-regional-releases",
    },
    {
      "binding": "SIMULATION_ARTIFACTS",
      "bucket_name": "analog-canvas-simulation-artifacts-production",
    },
  ],
  // Re-answers stored Gallery netlist marks a deployed rule change left
  // behind, one batch a tick. It reads a single count and stops when none of
  // them is stale, which is every tick but the ones after such a change.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "SIMULATION_JOBS",
        "queue": "analog-canvas-simulation-production",
      },
    ],
    "consumers": [
      {
        "queue": "analog-canvas-simulation-production",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // The shared operator gateway owns the single ngspice execution slot.
        "max_concurrency": 1,
        "max_retries": 3,
        "retry_delay": 2,
        "dead_letter_queue": "analog-canvas-simulation-production-dlq",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnalyticsDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AgentSessionDO"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["GalleryDO"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["AuthDO"],
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["SimulationControlDO"],
    },
    { "tag": "v6", "new_sqlite_classes": ["ComponentLibraryDO"] },
    { "tag": "v7", "new_sqlite_classes": ["TopologyTaskDO"] },
  ],
  "observability": {
    "enabled": true,
  },
}
