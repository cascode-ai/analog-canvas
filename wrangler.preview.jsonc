{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // Dormant Preview storage authority. The hosted Preview channel was retired
  // on 2026-09-20. This script has no route, workers.dev address, scheduled
  // trigger or queue consumer. Keep its Durable Object migrations and data
  // bindings intact so Preview accounts and Projects remain recoverable.
  "name": "interactive-circuit-maker-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "ICM_CHANNEL": "preview",
    "ICM_GALLERY_UPSTREAM": "https://analog-canvas.tokenzhang.com",
    "SIMULATION_UPSTREAM_URL": "https://sim-fra.analog-canvas.tokenzhang.com",
    "SIMULATION_DEFAULT_EXECUTOR": "operator-host",
    "VACASK_UPSTREAM_URL": "https://vacask-preview-sim.tokenzhang.com",
    "VACASK_PROFILE_ID": "vacask-sky130-candidate",
  },
  "durable_objects": {
    "bindings": [
      { "name": "COMPONENT_LIBRARY", "class_name": "ComponentLibraryDO" },
      { "name": "ANALYTICS", "class_name": "AnalyticsDO" },
      { "name": "AGENT_SESSION", "class_name": "AgentSessionDO" },
      { "name": "GALLERY", "class_name": "GalleryDO" },
      { "name": "AUTH", "class_name": "AuthDO" },
      { "name": "SIMULATION_CONTROL", "class_name": "SimulationControlDO" },
    ],
  },
  "r2_buckets": [
    {
      "binding": "SIMULATION_ARTIFACTS",
      "bucket_name": "analog-canvas-simulation-artifacts-preview",
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AnalyticsDO"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentSessionDO"] },
    { "tag": "v3", "new_sqlite_classes": ["AuthDO"] },
    { "tag": "v4", "new_sqlite_classes": ["GalleryDO"] },
    { "tag": "v5", "new_sqlite_classes": ["NgspiceContainer"] },
    { "tag": "v6", "deleted_classes": ["NgspiceContainer"] },
    { "tag": "v7", "new_sqlite_classes": ["SimulationControlDO"] },
    { "tag": "v8", "new_sqlite_classes": ["ComponentLibraryDO"] },
  ],
  "observability": {
    "enabled": false,
  },
}
